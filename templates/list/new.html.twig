{% extends 'base.html.twig' %}

{% block title %}Add a level in the list{% endblock %}

{% block body %}
    <div class="form-container">
        <h1>Add a level to the list</h1>

        {{ form_start(form, {'attr': {'class': 'custom-form'}}) }}
        <div class="form-fields">
            {{ form_widget(form) }}
        </div>
        <button type="submit" class="btn-submit">
            <span>Créer</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
        </button>
        {{ form_end(form) }}
    </div>

    <style>
        body {
            background: #0a0a0a;
            min-height: 100vh;
        }

        .form-container {
            max-width: 650px;
            margin: 60px auto;
            padding: 50px;
            background: linear-gradient(145deg, rgba(30, 30, 30, 0.9), rgba(20, 20, 20, 0.95));
            border-radius: 20px;
            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.6),
                0 0 0 1px rgba(255, 62, 3, 0.1);
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #ff3e03, rgb(255, 210, 0), #ff3e03);
            background-size: 200% 100%;
            animation: shimmer 3s linear infinite;
        }

        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        h1 {
            color: #ffffff;
            text-align: center;
            margin-bottom: 40px;
            font-size: 2.2rem;
            font-weight: 700;
            background: linear-gradient(135deg, #ff3e03, rgb(255, 210, 0), #ff8c00);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.5px;
        }

        .form-fields {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .custom-form label {
            display: block;
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.95rem;
            margin-bottom: 10px;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        .custom-form input[type="text"],
        .custom-form input[type="number"],
        .custom-form textarea,
        .custom-form select {
            width: 100%;
            padding: 15px 18px;
            background: rgba(255, 255, 255, 0.08);
            border: 2px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            color: #ffffff;
            font-size: 1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-sizing: border-box;
        }

        .custom-form input[type="text"]:focus,
        .custom-form input[type="number"]:focus,
        .custom-form textarea:focus,
        .custom-form select:focus {
            outline: none;
            border-color: #ff3e03;
            background: rgba(255, 255, 255, 0.12);
            box-shadow:
                0 0 0 4px rgba(255, 62, 3, 0.15),
                0 8px 16px rgba(255, 62, 3, 0.1);
            transform: translateY(-2px);
        }

        .custom-form input[type="text"]::placeholder,
        .custom-form textarea::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        .custom-form > div {
            margin-bottom: 0;
        }

        .btn-submit {
            width: 100%;
            padding: 16px 28px;
            background: linear-gradient(135deg, #ff3e03, rgb(255, 150, 0));
            border: none;
            border-radius: 12px;
            color: #ffffff;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            margin-top: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 8px 24px rgba(255, 62, 3, 0.3);
            position: relative;
            overflow: hidden;
        }

        .btn-submit::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-submit:hover::before {
            left: 100%;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(255, 62, 3, 0.5);
            background: linear-gradient(135deg, #ff5520, rgb(255, 180, 0));
        }

        .btn-submit:active {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(255, 62, 3, 0.4);
        }

        .btn-submit svg {
            transition: transform 0.3s;
        }

        .btn-submit:hover svg {
            transform: translateX(5px);
        }

        @media (max-width: 768px) {
            .form-container {
                margin: 30px 20px;
                padding: 35px 25px;
            }

            h1 {
                font-size: 1.8rem;
                margin-bottom: 30px;
            }

            .btn-submit {
                font-size: 1rem;
                padding: 14px 24px;
            }
        }

        .form-container {
            animation: slideIn 0.5s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

{% endblock %}
